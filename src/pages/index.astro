---
import Cover from '../components/Cover.astro';
import NewsletterSubscribe from '../components/NewsletterSubscribe.astro';
import PostCard from '../components/PostCard.astro';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CATEGORIES, categoryOf, fmtDate, getPosts, readingMinutes } from '../lib/posts';

const posts = await getPosts();
const [feature, ...rest] = posts;
const side = rest.slice(0, 3);
const latest = rest.slice(3, 9);
const cats = CATEGORIES.map((c) => ({ ...c, posts: posts.filter((p) => categoryOf(p).slug === c.slug) })).filter((c) => c.posts.length);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main class="wrap">
		<section class="intro">
			<p class="eyebrow">Seoul Travel & K-Beauty Notes</p>
			<h1>渡韓前に読む、<br class="br" />ソウルの実用ノート。</h1>
			<p class="sub">オリーブヤングの新作コスメ、免税の手続き、交通や両替のコツまで。旅の前に知っておきたいことを、わかりやすく整理しています。</p>
		</section>

		{
			feature && (
				<section class="top">
					<a href={`/blog/${feature.id}/`} class="feature">
						<Cover post={feature} size="lg" eager />
						<div class="f-body">
							<span class="cat-pill">{categoryOf(feature).label}</span>
							<h2>{feature.data.title}</h2>
							<p>{feature.data.description}</p>
							<span class="meta">
								{fmtDate(feature.data.pubDate)} · {readingMinutes(feature)}分で読める
							</span>
						</div>
					</a>
					<div class="side">
						<p class="side-h">NEW ARRIVALS</p>
						{side.map((p) => (
							<PostCard post={p} variant="row" />
						))}
					</div>
				</section>
			)
		}

		{
			latest.length > 0 && (
				<section>
					<div class="section-head">
						<h2>新着記事</h2>
						<a href="/blog/" class="more">すべて見る →</a>
					</div>
					<div class="grid">
						{latest.map((p) => (
							<PostCard post={p} />
						))}
					</div>
				</section>
			)
		}

		<section>
			<div class="section-head">
				<h2>カテゴリから探す</h2>
			</div>
			<div class="cats">
				{
					CATEGORIES.map((c) => {
						const n = posts.filter((p) => categoryOf(p).slug === c.slug).length;
						return (
							<a href={`/category/${c.slug}/`} class="cat" style={`--tone:${c.tone};--cink:${c.ink}`}>
								<span class="c-en">{c.en}</span>
								<span class="c-label">{c.label}</span>
								<span class="c-n">{n}本の記事</span>
							</a>
						);
					})
				}
			</div>
		</section>

		{
			posts.length >= 9 &&
			cats.slice(0, 2).map((c) => (
				<section>
					<div class="section-head">
						<h2>{c.label}</h2>
						<a href={`/category/${c.slug}/`} class="more">もっと見る →</a>
					</div>
					<div class="grid">
						{c.posts.slice(0, 3).map((p) => (
							<PostCard post={p} />
						))}
					</div>
				</section>
			))
		}

		<div class="nl">
			<NewsletterSubscribe />
		</div>
	</main>
</Base>

<style>
	.intro {
		text-align: center;
		padding: 64px 0 44px;
	}
	.intro h1 {
		margin-top: 14px;
		font-size: clamp(28px, 4.6vw, 46px);
		line-height: 1.45;
		letter-spacing: 0.06em;
	}
	.sub {
		margin: 18px auto 0;
		max-width: 560px;
		color: var(--ink-2);
		font-size: 15px;
		line-height: 1.9;
	}
	.br {
		display: none;
	}
	.top {
		display: grid;
		grid-template-columns: 1.65fr 1fr;
		gap: 44px;
		padding-top: 8px;
	}
	.feature {
		display: block;
	}
	.f-body {
		padding-top: 22px;
	}
	.f-body h2 {
		margin-top: 12px;
		font-size: clamp(22px, 2.6vw, 30px);
		line-height: 1.5;
		transition: color 0.2s;
	}
	.f-body p {
		margin: 12px 0 12px;
		color: var(--ink-2);
		font-size: 14.5px;
		line-height: 1.9;
	}
	.feature:hover h2 {
		color: var(--accent);
	}
	.side {
		display: flex;
		flex-direction: column;
		gap: 22px;
		border-left: 1px solid var(--line);
		padding-left: 32px;
	}
	.side-h {
		margin: 0;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.22em;
		color: var(--ink-3);
		border-bottom: 1px solid var(--ink);
		padding-bottom: 10px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 40px 32px;
	}
	.cats {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 14px;
	}
	.cat {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 22px 18px;
		border-radius: var(--radius);
		background: var(--tone);
		color: var(--cink);
		transition: transform 0.25s;
	}
	.cat:hover {
		transform: translateY(-3px);
	}
	.c-en {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.22em;
	}
	.c-label {
		font-family: var(--serif);
		font-weight: 700;
		font-size: 16px;
	}
	.c-n {
		font-size: 11.5px;
		opacity: 0.8;
	}
	.nl {
		margin-top: 72px;
	}
	@media (max-width: 960px) {
		.top {
			grid-template-columns: 1fr;
			gap: 32px;
		}
		.side {
			border-left: none;
			padding-left: 0;
		}
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.cats {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 600px) {
		.intro {
			padding: 40px 0 28px;
			text-align: left;
		}
		.sub {
			margin-left: 0;
		}
		.br {
			display: inline;
		}
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
