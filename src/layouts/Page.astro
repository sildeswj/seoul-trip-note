---
// About・プライバシーなどの固定ページ用レイアウト。
import Base from './Base.astro';

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	heroImage?: unknown;
	eyebrow?: string;
}
const { title, description, eyebrow = 'SEOUL TRIP NOTE' } = Astro.props;
---

<Base title={`${title} | SEOUL TRIP NOTE`} description={description}>
	<main class="page">
		<header class="ph">
			<p class="eyebrow">{eyebrow}</p>
			<h1>{title}</h1>
			<p class="lead">{description}</p>
		</header>
		<div class="prose">
			<slot />
		</div>
	</main>
</Base>

<style>
	.page {
		width: min(var(--measure), calc(100% - 40px));
		margin: 56px auto 0;
	}
	.ph {
		padding-bottom: 28px;
		border-bottom: 1px solid var(--line);
		margin-bottom: 8px;
	}
	.ph h1 {
		font-size: clamp(26px, 4vw, 36px);
		margin-top: 10px;
	}
	.lead {
		margin: 14px 0 0;
		color: var(--ink-2);
		font-size: 15px;
	}
	.prose :global(> h2:first-child) {
		border-top: none;
		margin-top: 1.4em;
		padding-top: 0;
	}
</style>
