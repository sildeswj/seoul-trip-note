---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/" class="brand-link">🌸 SEOUL TRIP NOTE</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">ホーム</HeaderLink>
			<HeaderLink href="/blog">記事一覧</HeaderLink>
			<HeaderLink href="/about">メディア紹介</HeaderLink>
			<HeaderLink href="/privacy">ポリシー</HeaderLink>
		</div>
		<div class="nav-extra">
			<a href="https://jworld.dev" target="_blank" rel="noopener" class="studio-link">JWorld Studio ↗</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.2em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		position: sticky;
		top: 0;
		z-index: 50;
	}
	h2 {
		margin: 0;
		font-size: 1.1em;
	}
	.brand-link {
		color: #ff4b72;
		font-weight: 800;
		letter-spacing: -0.02em;
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
	}
	.internal-links {
		display: flex;
		gap: 0.2em;
	}
	nav a {
		padding: 1em 0.6em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: #ff4b72;
		color: #ff4b72;
		font-weight: 700;
	}
	.studio-link {
		font-size: 0.85rem;
		color: #666;
		padding: 0.4em 0.8em;
		border: 1px solid #e0e0e0;
		border-radius: 6px;
		text-decoration: none;
		transition: all 0.2s;
	}
	.studio-link:hover {
		border-color: #ff4b72;
		color: #ff4b72;
	}
	@media (max-width: 720px) {
		.studio-link {
			display: none;
		}
		nav a {
			padding: 0.8em 0.4em;
			font-size: 0.85rem;
		}
	}
</style>
