---
import { CATEGORIES } from '../lib/posts';
const path = Astro.url.pathname;
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
	<div class="wrap top">
		<a href="/" class="brand" aria-label="SEOUL TRIP NOTE ホーム">
			<span class="mark">SEOUL TRIP NOTE</span>
			<span class="tag">ソウル旅と韓国コスメの実用ノート</span>
		</a>
		<nav class="util" aria-label="サイト">
			<a href="/blog/" class:list={{ on: active('/blog') }}>記事一覧</a>
			<a href="/about/" class:list={{ on: active('/about') }}>About</a>
			<a href="#newsletter" class="sub">ニュースレター</a>
		</nav>
	</div>
	<nav class="cats" aria-label="カテゴリ">
		<div class="wrap cats-in">
			<a href="/" class:list={{ on: active('/') }}>ホーム</a>
			{CATEGORIES.map((c) => <a href={`/category/${c.slug}/`} class:list={{ on: active(`/category/${c.slug}`) }}>{c.label}</a>)}
		</div>
	</nav>
</header>

<style>
	.site-header {
		background: var(--paper);
		border-bottom: 1px solid var(--line);
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: saturate(1.2) blur(8px);
		background: rgba(251, 249, 246, 0.92);
	}
	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 18px 0 12px;
	}
	.brand {
		display: flex;
		flex-direction: column;
		line-height: 1.2;
	}
	.mark {
		font-family: var(--serif);
		font-weight: 700;
		font-size: 24px;
		letter-spacing: 0.14em;
		color: var(--ink);
	}
	.tag {
		margin-top: 4px;
		font-size: 11px;
		letter-spacing: 0.12em;
		color: var(--ink-3);
	}
	.util {
		display: flex;
		align-items: center;
		gap: 22px;
		font-size: 13px;
		color: var(--ink-2);
	}
	.util a:hover,
	.util a.on {
		color: var(--accent);
	}
	.util .sub {
		padding: 7px 14px;
		border: 1px solid var(--ink);
		border-radius: 999px;
		color: var(--ink);
		font-weight: 500;
	}
	.util .sub:hover {
		background: var(--ink);
		color: #fff;
	}
	.cats {
		border-top: 1px solid var(--line-2);
	}
	.cats-in {
		display: flex;
		gap: 26px;
		overflow-x: auto;
		scrollbar-width: none;
		font-size: 13px;
		color: var(--ink-2);
	}
	.cats-in::-webkit-scrollbar {
		display: none;
	}
	.cats a {
		padding: 11px 0;
		white-space: nowrap;
		border-bottom: 2px solid transparent;
	}
	.cats a:hover {
		color: var(--ink);
	}
	.cats a.on {
		color: var(--ink);
		font-weight: 700;
		border-bottom-color: var(--accent);
	}
	@media (max-width: 720px) {
		.top {
			padding: 14px 0 10px;
		}
		.mark {
			font-size: 18px;
		}
		.tag {
			font-size: 10px;
		}
		.util a:not(.sub) {
			display: none;
		}
		.util .sub {
			font-size: 12px;
			padding: 6px 12px;
		}
		.cats-in {
			gap: 20px;
		}
	}
</style>
